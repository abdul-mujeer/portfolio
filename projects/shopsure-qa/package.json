{
  "name": "shopsure-qa",
  "version": "1.0.0",
  "private": true,
  "description": "ShopSure — e-commerce demo application and its complete QA package (manual, API, UI and database testing).",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "vite build --config app/web/vite.config.ts",
    "seed": "node scripts/reset-db.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "start": "node app/server/src/index.js",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck:web": "tsc -p app/web/tsconfig.json --noEmit",
    "test:api": "playwright test tests/api --project=api",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:db": "node scripts/run-db-checks.mjs",
    "test:postman": "node scripts/newman-run.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "test:seeded-defects": "node scripts/seeded-defects-run.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:csv": "node scripts/docs/generate-csv.mjs",
    "docs:report": "node scripts/reports/build-report.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autocannon": "^8.0.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "newman": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^5.4.14"
  }
}
