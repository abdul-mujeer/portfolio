# ShopSure QA — environment template
# Copy to .env for local use. NEVER commit the real .env file.
# All values below are demo/test values, not secrets.

# HTTP port for the API + built web app
PORT=4100

# SQLite database file (relative to the project root or absolute)
DB_PATH=app/server/data/shopsure.db

# development | test | production
NODE_ENV=development

# Session/token signing secret.
# In development a well-known default is used, but production boot FAILS unless this is set
# to a strong random value (>= 32 chars).
APP_SECRET=dev-only-insecure-secret-change-me

# 1 enables the deliberately seeded defects (see test-documentation/seeded-defects.md).
# Keep 0 for normal runs.
SEED_DEFECTS=0

# Demo credentials created by the seed script (documented, not secret):
#   customer@example.com / Customer#12345   (role: CUSTOMER)
#   second@example.com   / Second#12345     (role: CUSTOMER, isolation tests)
#   admin@example.com    / Admin#12345      (role: ADMIN)
