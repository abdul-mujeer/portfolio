# TaskFlow API - environment template.
# Copy to `.env` for local runs: `node --env-file-if-exists=.env` is wired into
# `npm start` / `npm run dev`, so a `.env` file is picked up automatically.
# NEVER commit a real `.env`.

# HTTP port for the API + console (load tests and suites assume 4300).
PORT=4300

# SQLite database file, relative to the project root or absolute.
# The default demo database lives here; test suites use `.data/taskflow.test.db`.
DB_PATH=app/server/data/taskflow.db

# `development` | `test` | `production`.
# production: session cookie gets the Secure flag and APP_SECRET is mandatory.
NODE_ENV=development

# Secret used to HMAC-sign opaque session tokens. Use a long random value in
# any real environment. The app falls back to a documented dev-only default.
APP_SECRET=replace-with-a-long-random-string

# 0 = clean demo (default). 1 = enables two clearly labelled SEEDED defects for
# the detection exercise documented in test-documentation/seeded-defects.md.
# Never leave this at 1 for normal runs.
SEED_DEFECTS=0

# ---------------------------------------------------------------------------
# Demo credentials created by `npm run seed` (synthetic example.com accounts -
# they are NOT secrets and are safe to publish):
#   owner@example.com      / Owner#12345    (OWNER of TASK + ARCH, ADMIN of OPS)
#   admin@example.com      / Admin#12345    (ADMIN of TASK, OWNER of OPS)
#   member@example.com     / Member#12345   (MEMBER of TASK + ARCH)
#   outsider@example.com   / Outside#12345  (MEMBER of OPS only)
#   noprojects@example.com / Solo#12345     (member of no project)
