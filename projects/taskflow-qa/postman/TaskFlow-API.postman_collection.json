    {
      "name": "05 - Archive, cleanup & logout",
      "item": [
        {
          "name": "Owner renames the project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 renamed', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().name).to.include('renamed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman QA project renamed {{qaRun}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
          }
        },
        {
          "name": "Owner archives the project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 archived', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().archived).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/archive" }
        },
        {
          "name": "Archived reads still work (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 tasks readable', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks" }
        },
        {
          "name": "Archived mutations are 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 ARCHIVED_PROJECT', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().error.code).to.eql('ARCHIVED_PROJECT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Should be blocked\"\n}" },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks"
          }
        },
        {
          "name": "Archived projects also reject DELETE (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 ARCHIVED_PROJECT for delete', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().error.code).to.eql('ARCHIVED_PROJECT');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/projects/{{projectId}}" }
        },
        {
          "name": "Create a scratch project for the delete flow",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const digitMap = 'ABCDEFGHIJ';",
                  "const raw = (Date.now().toString(36) + Math.floor(Math.random() * 2176782336).toString(36))",
                  "  .toUpperCase()",
                  "  .replace(/[0-9]/g, (d) => digitMap[Number(d)]);",
                  "pm.environment.set('scratchKey', ('SD' + raw).slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const scratchBody = pm.response.json();",
                  "pm.test('201 scratch project', () => pm.response.to.have.status(201));",
                  "pm.environment.set('scratchId', scratchBody.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{scratchKey}}\",\n  \"name\": \"Postman scratch {{qaRun}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects"
          }
        },
        {
          "name": "Delete the scratch project (OWNER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/projects/{{scratchId}}" }
        },
        {
          "name": "Deleted project is gone (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 after delete', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/projects/{{scratchId}}" }
        },
        {
          "name": "Logout clears the session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 logged out', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/auth/logout" }
        },
        {
          "name": "After logout /auth/me is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 UNAUTHENTICATED', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/auth/me" }
        }
      ]
    }
