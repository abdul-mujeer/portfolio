# PeopleCore QA — project level ignore rules (the repository root .gitignore also applies)

# Local databases — never committed. .data/ holds the test database, app/server/data/
# holds the development database created by "npm run db:reset".
.data/
*.db
*.db-journal
*.db-wal
*.db-shm
app/server/data/

# Playwright raw output (the summarised counts live in test-reports/summary.json,
# screenshots and traces are regenerated by the suites)
test-results/
playwright-report/
test-reports/playwright/
test-reports/tmp/

# The repository root .gitignore ignores any directory named "logs"; the raw command
# transcripts under test-evidence/logs are required evidence, so re-include them.
!test-evidence/logs/

# The repository root .gitignore has a ".env.*" rule (aimed at .env.local etc.) which would
# also swallow the required template. It contains placeholders/demo values only.
!.env.example
