<%- include('partials/head', { title: employee.fullName }) %>

<div class="page-actions">
  <h1 style="margin: 0" data-testid="employee-detail-name"><%= employee.fullName %></h1>
  <span class="muted" data-testid="employee-detail-code"><%= employee.employeeCode %></span>
  <% if (canManage) { %>
  <a class="button" href="/employees/<%= employee.id %>/edit" data-testid="edit-employee-link">Edit</a>
  <% } %>
  <% if (canDelete) { %>
  <form method="post" action="/employees/<%= employee.id %>/delete" data-testid="delete-employee-form">
    <button class="danger" type="submit" data-testid="delete-employee-button">Delete</button>
  </form>
  <% } %>
</div>

<section class="panel" data-testid="employee-detail">
  <h2>Profile</h2>
  <dl class="profile">
    <div><dt>Email</dt><dd data-testid="profile-email"><%= employee.email %></dd></div>
    <div><dt>Role</dt><dd data-testid="profile-role"><%= employee.role %></dd></div>
    <div><dt>Department</dt><dd data-testid="profile-department"><%= employee.departmentName || '—' %></dd></div>
    <div><dt>Position</dt><dd data-testid="profile-position"><%= employee.position %></dd></div>
    <div><dt>Status</dt><dd><span class="status status-<%= employee.status %>" data-testid="profile-status"><%= employee.status %></span></dd></div>
    <div><dt>Hire date</dt><dd data-testid="profile-hire-date"><%= employee.hireDate %></dd></div>
    <div><dt>Manager</dt><dd data-testid="profile-manager"><%= employee.managerName || '—' %></dd></div>
    <div><dt>Phone</dt><dd data-testid="profile-phone"><%= employee.phone || '—' %></dd></div>
    <% if (employee.salary !== undefined) { %>
    <div><dt>Salary</dt><dd data-testid="profile-salary"><%= employee.salary.toFixed(2) %></dd></div>
    <% } else { %>
    <div><dt>Salary</dt><dd data-testid="profile-salary-redacted">Not visible for your role</dd></div>
    <% } %>
  </dl>
</section>

<nav class="tabs" aria-label="Employee record sections">
  <a href="/employees/<%= employee.id %>?tab=attendance"
     data-testid="tab-attendance" <%= tab === 'attendance' ? 'aria-current="page"' : '' %>>Attendance</a>
  <a href="/employees/<%= employee.id %>?tab=leave"
     data-testid="tab-leave" <%= tab === 'leave' ? 'aria-current="page"' : '' %>>Leave requests</a>
</nav>

<div class="panel">
  <% if (tab === 'attendance') { %>
  <% if (attendance.length === 0) { %>
  <p class="empty-state" data-testid="attendance-empty-state">No attendance recorded for this employee.</p>
  <% } else { %>
  <table data-testid="employee-attendance-table">
    <thead><tr><th>Date</th><th>Status</th><th>Check in</th><th>Check out</th><th>Notes</th></tr></thead>
    <tbody>
      <% attendance.forEach(function (row) { %>
      <tr data-testid="attendance-row" data-attendance-id="<%= row.id %>">
        <td><%= row.workDate %></td>
        <td><span class="status status-<%= row.status %>"><%= row.status %></span></td>
        <td><%= row.checkIn || '—' %></td>
        <td><%= row.checkOut || '—' %></td>
        <td><%= row.notes || '—' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
  <% } else { %>
  <% if (leave.length === 0) { %>
  <p class="empty-state" data-testid="leave-empty-state">No leave requests for this employee.</p>
  <% } else { %>
  <table data-testid="employee-leave-table">
    <thead><tr><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Status</th><th>Reviewer</th><th>Comment</th></tr></thead>
    <tbody>
      <% leave.forEach(function (row) { %>
      <tr data-testid="leave-row" data-leave-id="<%= row.id %>">
        <td><%= row.leaveType %></td>
        <td><%= row.startDate %></td>
        <td><%= row.endDate %></td>
        <td><%= row.days %></td>
        <td><span class="status status-<%= row.status %>" data-testid="leave-status"><%= row.status %></span></td>
        <td><%= row.reviewerName || '—' %></td>
        <td class="small"><%= row.reviewComment || '—' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
  <% } %>
</div>

<p class="small"><a href="/employees" data-testid="back-to-employees">← Back to employees</a></p>

<%- include('partials/foot') %>
