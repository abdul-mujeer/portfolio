# PeopleCore HRMS — environment template (copy to .env or export manually)
#
# There are NO real secrets in this project: every value below is a development
# default and the seeded accounts use documented demo passwords (see README).

# HTTP server
PORT=4200
HOST=127.0.0.1
NODE_ENV=development

# SQLite file used by the application (relative paths resolve from the project root)
DB_PATH=app/server/data/peoplecore.db

# Only used to sign nothing today (kept for parity with the portfolio standard);
# replace it in any real deployment.
APP_SECRET=peoplecore-dev-only-secret

# Session and login throttling
SESSION_TTL_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# 1 = enable the two documented SEEDED defects (default 0 = clean application)
SEED_DEFECTS=0

# Optional: pin the seed reference date so relative dates are reproducible
# SEED_AS_OF=2026-01-15
